{
    "algorithm": "ac-ctw",
    "environment": "external",
    "ct_depth": 32,
    "agent_horizon": 1,
    "observation_bits": 64,
    "reward_bits": 8,
    "agent_actions": 5,
    "num_simulations": 640,
    "exploration_exploitation_ratio": 1.141,
    "terminate-lifetime": 300,
    "external_config": {
        "command": "/bin/bash",
        "args": [
            "--norc",
            "--noprofile"
        ],
        "actions": [
            "ls -F",
            "ls crates/infotheory/src/",
            "cat crates/infotheory/src/main.rs",
            "grep -i 'ai' crates/infotheory/src/main.rs",
            "echo 'Scanning complete.'"
        ],
        "reward_pattern": "run_aixi_mode",
        "step_cost": 2,
        "verbose": false
    }
}
