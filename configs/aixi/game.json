{
  "algorithm": "fac-ctw",
  "environment": "external",
  "agent_horizon": 4,
  "ct_depth": 128,
  "observation_bits": 64,
  "reward_bits": 8,
  "agent_actions": 6,
  "num_simulations": 700,
  "exploration_exploitation_ratio": 1.14,
  "terminate-lifetime": 500,
  "external_config": {
    "command": "/bin/bash",
    "args": [
      "--norc",
      "--noprofile"
    ],
    "actions": [
      "bash sim/step.sh scan",
      "bash sim/step.sh reroute_power",
      "bash sim/step.sh repair_A",
      "bash sim/step.sh repair_B",
      "bash sim/step.sh repair_C",
      "bash sim/step.sh commit"
    ],
    "reward_pattern": "SUCCESS",
    "step_cost": 2,
    "verbose": true
  }
}